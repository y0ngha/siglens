{
    "name": "siglens",
    "version": "0.90.0",
    "private": true,
    "author": "y0ngha <dev.y0ngha@gmail.com>",
    "license": "MIT",
    "scripts": {
        "copy:backtesting": "mkdir -p public/backtesting && cp 'src/app/[locale]/backtesting/data.json' public/backtesting/data.json",
        "clear:backtesting": "rm -rf public/backtesting",
        "predev": "yarn clear:backtesting && yarn copy:backtesting",
        "prebuild": "yarn clear:backtesting && yarn copy:backtesting",
        "clear:build": "rm -rf .next",
        "dev": "yarn predev && next dev --turbopack -p 4200",
        "build": "yarn prebuild && rm -rf .next && NEXT_BUILD_DATE=${NEXT_BUILD_DATE:-$(date -u +'%Y-%m-%dT%H:%M:%SZ')} next build",
        "analyze": "ANALYZE=true yarn build",
        "start": "next start",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "lint:staged": "oxlint --fix",
        "lint:style": "stylelint --allow-empty-input '**/*.{css,scss}'",
        "lint:style-fix": "stylelint --fix '**/*.{css,scss}'",
        "db:generate": "NODE_OPTIONS=--conditions=react-server dotenv -e .env.local -- drizzle-kit generate",
        "db:migrate": "dotenv -e .env.local -- node_modules/.bin/tsx db/scripts/migrate.ts",
        "db:seed:terms": "NODE_OPTIONS=--conditions=react-server dotenv -e .env.local -- node_modules/.bin/tsx db/scripts/seedTerms.ts",
        "db:migrate:tickers": "dotenv -e .env.local -- node_modules/.bin/tsx scripts/seed-korean-tickers.ts",
        "db:seed:crypto": "dotenv -e .env.local -- node_modules/.bin/tsx scripts/seed-crypto-assets.ts",
        "db:seed:crypto-korean": "dotenv -e .env.local -- node_modules/.bin/tsx scripts/seed-crypto-korean-names.ts",
        "db:seed:kr-names": "dotenv -e .env.local -- node_modules/.bin/tsx scripts/seed-kr-listed-names.ts",
        "db:backfill:calendar": "dotenv -e .env.local -- node_modules/.bin/tsx scripts/backfillEconomicCalendar.ts",
        "db:seed:calendar-analysis": "dotenv -e .env.local -- node_modules/.bin/tsx scripts/seedEconomicEventAnalysis.ts",
        "metrics": "NODE_OPTIONS=--conditions=react-server dotenv -e .env.local -- node_modules/.bin/tsx scripts/metrics.ts",
        "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
        "test:quiet": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--no-experimental-webstorage vitest run --reporter=dot",
        "test:related": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--no-experimental-webstorage vitest related --run --passWithNoTests",
        "test-watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
        "test-coverage": "NODE_OPTIONS=\"--no-experimental-webstorage --max-old-space-size=4096\" vitest run --coverage",
        "test-coverage-watch": "NODE_OPTIONS=\"--no-experimental-webstorage --max-old-space-size=4096\" vitest --coverage",
        "test-coverage-report": "NODE_OPTIONS=\"--no-experimental-webstorage --max-old-space-size=4096\" vitest run --coverage --reporter=verbose",
        "e2e": "e2e/run-e2e.sh",
        "e2e:up": "docker compose -f docker-compose.e2e.yml up -d",
        "e2e:down": "docker compose -f docker-compose.e2e.yml down -v",
        "e2e:db": "node_modules/.bin/tsx e2e/setup/run-global-setup.ts",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "format": "oxfmt",
        "format:staged": "oxfmt --no-error-on-unmatched-pattern",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
        "validate:skills": "tsx scripts/validate-skills.ts",
        "i18n:extract": "node scripts/i18n/extract.mjs",
        "i18n:translate": "dotenv -e .env.local -- node scripts/i18n/translate.mjs",
        "i18n:verify": "node scripts/i18n/verify.mjs",
        "i18n:lint": "node scripts/i18n/lint.mjs",
        "i18n:routes": "node scripts/i18n/routes.mjs",
        "skills:digest-verify": "tsx scripts/skills-digest.ts verify",
        "skills:digest-update": "tsx scripts/skills-digest.ts update-meta",
        "format:check": "oxfmt --check",
        "prepare": "husky",
        "release": "dotenv -e .env.local -- release-it --verbose",
        "release:patch": "dotenv -e .env.local -- release-it patch --verbose",
        "release:minor": "dotenv -e .env.local -- release-it minor --verbose",
        "release:major": "dotenv -e .env.local -- release-it major --verbose",
        "fetch-this-week-tasks": "cd scripts/fetch-this-week-tasks && node --env-file=.env index.js",
        "update-popular-tickers": "NODE_OPTIONS=--conditions=react-server dotenv -e .env.local -- node_modules/.bin/tsx update-popular-tickers.ts",
        "update-popular-cryptos": "NODE_OPTIONS=--conditions=react-server dotenv -e .env.local -- node_modules/.bin/tsx scripts/update-popular-cryptos.ts",
        "db:backfill:content-locale": "dotenv -e .env.local -- node_modules/.bin/tsx db/scripts/backfillContentLocale.ts",
        "db:backfill:snapshot-first-gen": "dotenv -e .env.local -- node_modules/.bin/tsx db/scripts/backfillSnapshotFirstGeneratedAt.ts",
        "db:verify:content-locale": "dotenv -e .env.local -- node_modules/.bin/tsx db/scripts/verifyContentLocale.ts",
        "db:translate:content-locale": "dotenv -e .env.local -- node_modules/.bin/tsx db/scripts/translateContentLocale.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.128.0",
        "@aws-sdk/client-s3": "^3.1138.0",
        "@google/genai": "^2.24.0",
        "@neondatabase/serverless": "^1.1.0",
        "@tanstack/react-query": "^5.103.2",
        "@upstash/redis": "^1.39.0",
        "@y0ngha/siglens-core": "1.17.2",
        "bcryptjs": "^3.0.3",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.3",
        "gray-matter": "^4.0.3",
        "jsonrepair": "^3.15.0",
        "lightweight-charts": "^5.2.1",
        "next": "16.3.6",
        "next-intl": "4.14.6",
        "openai": "7.23.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-error-boundary": "^6.1.6",
        "react-markdown": "^10.1.0",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "resend": "^6.28.1",
        "sharp": "^0.35.4",
        "tailwind-merge": "^3.7.0",
        "vaul": "patch:vaul@npm%3A1.1.2#~/.yarn/patches/vaul-npm-1.1.2-7a571c1ad6.patch",
        "yahoo-finance2": "^4.0.2"
    },
    "devDependencies": {
        "@babel/parser": "^8.0.6",
        "@next/bundle-analyzer": "16.3.6",
        "@playwright/test": "^1.63.0",
        "@release-it/conventional-changelog": "^12.0.2",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^24",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@vitest/coverage-v8": "^5.0.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "dotenv-cli": "^11.0.0",
        "drizzle-kit": "^0.31.11",
        "glob": "^13.0.6",
        "husky": "^9.1.7",
        "jsdom": "^30.1.1",
        "lint-staged": "^17.5.1",
        "oxfmt": "0.70.0",
        "oxlint": "1.85.0",
        "postgres": "^3.4.9",
        "release-it": "^21.1.0",
        "server-only": "^0.0.1",
        "stylelint": "^17.15.0",
        "stylelint-config-recess-order": "^7.8.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-order": "^8.1.1",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "7.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    },
    "packageManager": "yarn@4.18.0",
    "browserslist": [
        "last 2 Chrome versions",
        "last 2 ChromeAndroid versions",
        "last 2 Firefox versions",
        "last 2 Safari versions",
        "last 2 Edge versions",
        "iOS >= 15",
        "not dead"
    ]
}
