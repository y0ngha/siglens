# ── Market Data ────────────────────────────────────────────────────────────
# https://site.financialmodelingprep.com/developer
FMP_API_KEY=

# ── AI — Chatbot ──────────────────────────────────────────────────────────
# Server api key per provider — covers free-tier models (server pays).
# https://aistudio.google.com/apikey
GEMINI_CHAT_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_CHAT_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_CHAT_API_KEY=
# https://platform.deepseek.com/api_keys
DEEPSEEK_CHAT_API_KEY=

# ── Ticker Translation ─────────────────────────────────────────────────────
# Company-name/description translation runs on DEEPSEEK_API_KEY (above).
# There is no separate translation key — translator spend is separated in
# telemetry by `jobId: 'translate'`, not by key.
# Default when unset/invalid: deepseek-v4-flash. Only DeepSeek models are
# accepted — anything else (unknown value, another provider's model) silently
# falls back to the default with a one-time console.warn, because the call is
# made with the DeepSeek key and a foreign model id would 401/400. See
# docs/reference/API.md (Ticker Translation section).
TRANSLATE_MODEL=

# ── Cache (Upstash Redis) ──────────────────────────────────────────────────
# https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_READONLY_TOKEN=

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# https://neon.tech
DATABASE_URL=

# ── Authentication ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=
# 32-byte hex strings — used to encrypt OAuth tokens and user API keys at rest
# Generate with: openssl rand -hex 32
OAUTH_TOKEN_ENCRYPTION_KEY=
LLM_API_KEY_ENCRYPTION_KEY=
# HMAC secret used to sign OAuth state cookies. Must be at least 32 bytes.
# Generate with: openssl rand -hex 32  (or any other source of 32+ bytes)
OAUTH_STATE_HMAC_SECRET=

# Bearer token required by cleanupExpiredSessionsAction. Set to the same value
# used by the external cron caller (e.g. EventBridge). Action throws unauthorized when
# missing, so production deployments must define this even if cron is not yet
# wired.
CRON_SECRET=

# ── Email (Resend) ─────────────────────────────────────────────────────────
# https://resend.com
RESEND_API_KEY=
EMAIL_FROM=

# ── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ── AdSense ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_PROGRESS=
NEXT_PUBLIC_ADSENSE_SLOT_PANEL_BOTTOM=
NEXT_PUBLIC_ADSENSE_ENABLED=false

# ── Package Registry ───────────────────────────────────────────────────────
# GitHub token with read:packages scope — for installing @y0ngha/siglens-core
# https://github.com/settings/tokens
SIGLENS_GITHUB_TOKEN=

# ── AI Analysis ──────────────────────────────────────────────────────────────
# Server-side API keys used by @y0ngha/siglens-core for LLM calls.
# All four are REQUIRED by check-env.sh: every provider appears in TIER_CONFIG.models.free
# (claude-haiku-4-5, gpt-5-mini, gemini-2.5-flash*, deepseek-v4-*), i.e. the server pays for all four.
# Required by check-env.sh → SSM key derivation for prod deploys.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ── ISR Cache (S3) ─────────────────────────────────────────────────────────
# S3 버킷 이름. 값이 있으면 production에서 ISR/fetch 캐시를 이 버킷으로 외부화하는
# cacheHandler를 활성화한다(디스크풀 방지). prod는 SSM(/siglens/ISR_CACHE_BUCKET)으로
# 주입되고 빌드 타임엔 deploy.yml의 build-arg로도 전달된다. dev는 비워두면 기본
# 파일시스템 캐시로 폴백한다.
ISR_CACHE_BUCKET=

# ── Ops Alerts (CloudWatch → SNS) ──────────────────────────────────────────
# infra/aws/07-alarms.sh가 SNS 토픽(siglens-alerts)을 idempotent 생성하고, 아래
# 주소가 설정돼 있으면 이메일을 구독한다(구독 후 confirm 메일 클릭 필요). 비워두면
# 토픽만 만들고 구독은 건너뛴다 — 알람 액션 자체는 항상 토픽에 연결된다.
ALARM_EMAIL=

# ── Debug ──────────────────────────────────────────────────────────────────
# Server-only verbose debug log toggle. Set to any truthy value (e.g. "1")
# to enable logs that may include user-facing content (e.g. translated news
# titles in submitNewsAnalysisAction). Leave empty in production.
# Intentionally NOT prefixed with NEXT_PUBLIC_ — that prefix inlines the
# value into the client bundle and would expose it to end users.
DEBUG_VERBOSE_LOGS=

# ── 한국 주식 (kr-equity) ───────────────────────────────────────────────────
# 셋 다 REQUIRED다. 코드는 키가 없어도 크래시하지 않고 빈 결과로 degrade하지만,
# 그 degrade는 "장애를 조용히 숨기는" 형태다 — 뉴스 탭이 비고 한글 검색이 안 되는데
# 에러는 어디에도 안 뜬다. `check-env.sh`가 배포 전에 SSM 부재를 잡아 주는 편이,
# 배포 후 사용자가 빈 화면을 보는 것보다 낫다.
#
# (OPTIONAL_KEYS에 넣지 않으므로 check-env.sh가 자동으로 필수로 수집한다.)
#
# 공공데이터포털 KRX상장종목정보(https://www.data.go.kr/data/15094775/openapi.do).
# `yarn db:seed:kr-names`가 korean_tickers에 한글 종목명을 적재하는 데 쓴다. 없으면
# 한글 검색이 큐레이션 9종목으로 제한되고, 종목코드·영문 검색은 그대로 동작한다.
# ⚠️ **일반 인증키(Decoding)** 를 넣어야 한다. Encoding 키를 넣으면 URLSearchParams가
# 한 번 더 인코딩해 403이 난다(클라이언트가 자동 디코딩하지만 원본을 그대로 두는 편이 안전).
DATA_GO_KR_SERVICE_KEY=

# 네이버 검색 API — 한국 종목 뉴스. 2026-07-31부로 개발자센터 신규 신청이 마감되어
# NAVER API HUB(네이버 클라우드)에서 발급한다. 없으면 국내 종목 뉴스 탭만 빈 상태가 된다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
