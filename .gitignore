# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (e2e) output artifacts
/test-results/
/playwright-report/
# Authed storageState produced by the e2e `setup` project (contains a session cookie)
/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local
.env.production
.env.yaml
.env


# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
/.idea/

# jest
.jest
/TODO.md
.vercel
/.claude/projects/

# .claude/agent-memory/는 로컬 전용이다(sub-agent가 쌓는 작업 메모 — 로컬 경로·운영
# 관찰이 섞여 공개 레포에 올리지 않는다). 새 워크트리에선 post-checkout 훅이 메인의
# 폴더로 심볼릭 링크를 걸어 메모가 워크트리와 함께 사라지지 않게 하고, pre-commit
# 훅이 `git add -f`로 강제 추가된 메모의 커밋을 막는다.
# 끝에 `/`를 붙이지 않는다 — 워크트리의 그 심볼릭 링크는 git에게 디렉터리가 아니라
# 파일이라, `/`가 붙은 패턴은 링크를 놓쳐 링크 자체가 커밋됐다(PR #987).
/.claude/agent-memory
# 마케팅 스킬이 읽는 제품 맥락 메모(로컬 전용, 공개 레포에 올리지 않는다).
/.claude/product-marketing-context.md
/worker/dist/
/worker/node_modules/
/.superpowers/
# docs/는 로컬 전용이다. 공개해도 되는 문서(서비스 소개·도메인 명세·코딩 규칙)만
# product/와 conventions/에 두고 추적한다. CI 리뷰 봇과 designDocTokenGuard가
# conventions/를 읽으므로 이 두 폴더는 체크아웃에 있어야 한다. 나머지(설계 spec·플랜,
# 런북, QA, 에이전트 워크플로)는 새 워크트리에 .worktreeinclude로 복사된다.
/docs/*
!/docs/product/
!/docs/conventions/

# backtest batch job state
/scripts/backtests/.batch-job.txt

/worker/.vscode/

.vscode/
# Dev-only preview routes — local testing, never deployed
/src/app/dev/
/.claire/
/.claude/worktrees/

**node_modules**

/scripts/**
# Tracked tooling that must run in CI (skill frontmatter validation gate).
!/scripts/validate-skills.ts
# Tracked tooling: PROMPT_DIGEST metadata verify/update-meta (Phase 2 / PR2a).
!/scripts/skills-digest.ts
!/scripts/__tests__/
!/scripts/__tests__/**
# SP-A: one-time backfill script + pure helpers (tracked so users can run them).
!/scripts/backfillEconomicCalendar.ts
# SP-D: one-time AI analysis seed script (user runs after SP-A backfill).
!/scripts/seedEconomicEventAnalysis.ts
# tsconfig.scripts.json의 Next 앰비언트 진입점.
!/scripts/next-ambient.d.ts
# Plan 1: FMP cryptocurrency-list sync script.
!/scripts/seed-crypto-assets.ts
# 한국 상장 종목 한글명 시드(공공데이터포털). package.json의 `db:seed:kr-names`가
# 이 파일을 실행하므로 추적하지 않으면 fresh checkout에서 스크립트가 사라진다.
!/scripts/seed-kr-listed-names.ts
# Tracked because scripts/__tests__/ imports them — untracking these two while
# keeping their test files broke every fresh checkout and CI run.
!/scripts/seed-crypto-korean-names.ts
!/scripts/update-popular-cryptos.ts
# Infra: post-build assertion script for standalone skills/ inclusion.
!/scripts/assert-standalone-skills.mjs
# Infra: ICU locale regression guard (Dockerfile builder+runner stages).
!/scripts/assert-icu-locale.mjs
# Infra: 배포 직후 ISR·엣지 캐시 예열 (deploy.yml 마지막 단계).
!/scripts/warm-isr.sh
# Infra: 배포 직후 Cloudflare HTML 태그 퍼지 (deploy.yml, 실패 시 purge_everything 폴백).
!/scripts/purge-cdn-cache.sh
# Infra: CDN 엣지 캐시 실측 프로브 (docs/architecture/CDN_CACHING.md §6에서 참조).
!/scripts/probe-cdn-cache.sh
# 로컬 개발 DB(Docker)·운영 DB SSM 터널·운영 비개인 데이터 시드. package.json db:dev:* / db:tunnel이 실행한다.
!/scripts/db-dev.sh
!/scripts/db-tunnel.sh
!/scripts/db-dev-seed-from-prod.sh
!/scripts/lib/
!/scripts/lib/**
# i18n 툴링 — `yarn i18n:extract/translate/verify/lint/routes`가 이 파일들을
# 실행한다. 추적하지 않으면 fresh checkout·CI에서 스크립트가 통째로 사라진다.
!/scripts/i18n/
!/scripts/i18n/**
# MAU/DAU 조회 스크립트 — `yarn metrics`가 이 파일을 실행한다. 추적하지 않으면
# fresh checkout에서 스크립트가 사라진다.
!/scripts/metrics.ts
# 가입 퍼널 리포트 — `yarn funnel:report`가 이 파일을 실행한다. 순수 helper는 scripts/lib에 있다.
!/scripts/funnel-report.ts
# IndexNow 1회성 백필(색인에서 빠진 URL 재크롤 요청) — 순수 helper는 scripts/lib에 있다.
!/scripts/indexnow-backfill.ts

# Local Lighthouse audit outputs (psi_*.json, desktop.json, mobile.json, headers.txt)
/lighthouse/
# brainstorming visual companion
.superpowers/
infra/aws/.env
infra/aws/.ids
# 핀된 AMI ID (region/account 종속, 운영자 로컬). CI는 vars.PINNED_AMI 사용.
infra/aws/.ami

.claude/scheduled_tasks.lock
infra/aws/.tunnel_id
