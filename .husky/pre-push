#!/bin/sh
set -e

echo "🔍 Running pre-push checks..."

tmp_dir=$(mktemp -d)
status=0
total_checks=4

if [ "${SIGLENS_RELEASE_E2E:-}" = "1" ]; then
    total_checks=7
fi

cleanup() {
    rm -rf "$tmp_dir"
}
trap cleanup EXIT

run_check() {
    label=$1
    log_file=$2
    shift 2

    echo "▶ $label"

    set +e
    "$@" > "$log_file" 2>&1
    code=$?
    set -e

    if [ "$code" -eq 0 ]; then
        echo "✅ $label"
        return 0
    fi

    echo "❌ $label"
    cat "$log_file"
    return "$code"
}

run_check "1/$total_checks format:check" "$tmp_dir/format-check.log" yarn format:check &
pid_format=$!

run_check "2/$total_checks lint" "$tmp_dir/lint.log" yarn lint &
pid_lint=$!

wait "$pid_format" || status=1
wait "$pid_lint" || status=1

run_check "3/$total_checks typecheck" "$tmp_dir/typecheck.log" yarn typecheck || status=1
# i18n 게이트: 키 패리티·ICU 따옴표·한글 잔존·용어집, 그리고 미추출 한국어 기준선.
# 둘 다 초 단위이고 모델을 부르지 않는다(결정적) — 사람이 손으로 칠 때만 도는
# 게이트는 결국 돌지 않는다.
run_check "4/$total_checks i18n" "$tmp_dir/i18n.log" sh -c 'yarn i18n:lint && yarn i18n:verify' || status=1

# 20260924 test, build는 github actions에서만 돌린다. 로컬에서 돌리면 prerender마다 FMP/Neon/Upstash를 부르므로
# (1) 로컬 .env.local에 프로덕션 자격증명이 들어있고, (2) prerender마다 실 서비스를 부르므로 느리고, (3) prerender마다 실 서비스를 부르므로 비용이 발생한다. 따라서 로컬 pre-push에서는 test, build를 돌리지 않는다. 대신 github actions에서만 test, build를 돌린다.

# run_check "5/$total_checks test" "$tmp_dir/test.log" yarn test:quiet || status=1
# SIGLENS_OFFLINE_BUILD=1: 로컬 .env.local은 프로덕션 FMP/Neon/Upstash 자격증명을
# 담고 있다 — 이 빌드 산출물은 버려지므로 실데이터가 필요 없고, 오히려 prerender마다
# 실 서비스를 부르는 걸 막아야 한다. Docker 배포 빌드는 이 플래그를 절대 설정하지 않는다
# (docs/architecture/DEPLOY_RUNBOOK.md 참조).
# UPSTASH_REDIS_REST_*=(빈 값): `@y0ngha/siglens-core`(getSectorSignals 등)는 앱의
# offline 게이트를 거치지 않고 자체적으로 process.env에서 Upstash 자격증명을 읽어
# 캐시 클라이언트를 만든다. Next의 loadEnvConfig는 이미 프리셋된(빈 문자열 포함) env를
# .env.local 값으로 덮어쓰지 않으므로, 여기서 빈 문자열로 선점해 두면 core가
# `readUpstashConfig`에서 null을 받아 캐시 접근을 끈다(siglens 측 어댑터 변경 없이).
# run_check "6/$total_checks build" "$tmp_dir/build.log" env SIGLENS_OFFLINE_BUILD=1 UPSTASH_REDIS_REST_URL= UPSTASH_REDIS_REST_TOKEN= UPSTASH_REDIS_REST_READONLY_TOKEN= yarn build || status=1

if [ "${SIGLENS_RELEASE_E2E:-}" = "1" ]; then
    run_check "7/$total_checks e2e" "$tmp_dir/e2e.log" yarn e2e || status=1
fi

if [ "$status" -ne 0 ]; then
    echo ""
    echo "❌ Pre-push checks failed. Push aborted."
    exit 1
fi

echo ""
echo "✅ All checks passed. Proceeding with push."
